<div class="max-w-6xl mx-auto">
  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-xl font-bold mb-4">Nova Sessão</h2>

    <%= form_with model: GameSession.new, url: sessions_path, class: "flex gap-4 items-end" do |f| %>
      <div class="flex-1">
        <%= f.label :client_name, "Nome do Cliente", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :client_name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Digite o nome", required: true %>
      </div>

      <div class="w-48">
        <%= f.label :session_type, "Tipo", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :session_type,
                     options_for_select([["Sala de Jogos - R$ 5,00", "sala_jogos"], ["Playstation 4 - R$ 7,00", "playstation4"], ["Sinuca - R$ 3,00", "sinuca"]]),
                     {},
                     class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%= f.submit "Iniciar Sessão", class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-bold mb-4">Sessões Ativas</h2>

    <%= turbo_stream_from "sessions" %>

    <div id="sessions-list">
      <% if @sessions.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Início</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Término</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tempo Restante</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ações</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <%= render partial: "sessions/session", collection: @sessions, as: :session %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-gray-500 text-center py-8">Nenhuma sessão ativa no momento.</p>
      <% end %>
    </div>
  </div>
</div>
