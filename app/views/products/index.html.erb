<div class="max-w-6xl mx-auto">
  <h1 class="text-3xl font-bold mb-6">Estoque</h1>

  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-xl font-bold mb-4">Cadastrar Produto</h2>

    <%= form_with model: @product, url: products_path, class: "flex gap-4 items-end" do |f| %>
      <div class="flex-1">
        <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Digite o nome", required: true %>
      </div>

      <div class="w-40">
        <%= f.label :price, "Preço (R$)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :price, step: "0.01", min: "0.01", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
      </div>

      <div class="w-40">
        <%= f.label :stock_quantity, "Estoque Inicial", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :stock_quantity, step: "1", min: "0", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", required: true %>
      </div>

      <%= f.submit "Cadastrar", class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
    <% end %>

    <% if @product.errors.any? %>
      <div class="mt-4 text-sm text-red-600">
        <%= @product.errors.full_messages.to_sentence %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-bold mb-4">Produtos</h2>

    <% if @products.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Produto</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Preço</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estoque</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vender</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Adicionar Estoque</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= render partial: "products/product", collection: @products, as: :product %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">Nenhum produto cadastrado.</p>
    <% end %>
  </div>
</div>
