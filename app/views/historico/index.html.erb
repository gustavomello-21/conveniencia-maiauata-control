<div class="max-w-6xl mx-auto">
  <h1 class="text-3xl font-bold mb-6">Histórico de Sessões</h1>

  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <%= form_with url: historico_path, method: :get, class: "flex gap-4 items-end" do |f| %>
      <div class="flex-1">
        <%= f.label :start_date, "Data Inicial", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :start_date, value: params[:start_date], class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="flex-1">
        <%= f.label :end_date, "Data Final", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :end_date, value: params[:end_date], class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%= f.submit "Filtrar", class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Limpar", historico_path, class: "bg-gray-400 text-white px-6 py-2 rounded-md hover:bg-gray-500" %>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <% if @sessions.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Cliente</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tipo</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Início</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fim</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duração</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Renovações</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Valor</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @sessions.each do |session| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= session.client_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= session.session_type_badge_class %>">
                    <%= session.session_type_label %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= session.started_at.strftime("%d/%m/%Y %H:%M") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= session.ended_at&.strftime("%d/%m/%Y %H:%M") || "-" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if session.ended_at %>
                    <%= ((session.ended_at - session.started_at) / 3600).round(2) %>h
                  <% else %>
                    -
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= session.renewals_count %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-medium">
                  R$ <%= number_to_currency(session.amount_paid, unit: "", precision: 2) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-8">Nenhuma sessão encontrada para o período selecionado.</p>
    <% end %>
  </div>
</div>
