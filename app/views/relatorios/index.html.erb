<div class="max-w-6xl mx-auto">
  <h1 class="text-3xl font-bold mb-6">Relatórios</h1>

  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <%= form_with url: relatorios_path, method: :get, class: "flex gap-4 items-end" do |f| %>
      <div class="flex-1">
        <%= f.label :date, "Data", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :date, value: params[:date] || @selected_date, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%= f.submit "Filtrar", class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 cursor-pointer" %>
      <%= link_to "Hoje", relatorios_path, class: "bg-gray-400 text-white px-6 py-2 rounded-md hover:bg-gray-500" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Total de Clientes</p>
          <p class="text-3xl font-bold text-gray-900 mt-2"><%= @total_clients %></p>
        </div>
        <div class="bg-blue-100 p-3 rounded-full">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Faturamento Total</p>
          <p class="text-3xl font-bold text-green-600 mt-2">R$ <%= number_to_currency(@total_revenue || 0, unit: "", precision: 2) %></p>
          <p class="text-xs text-gray-500 mt-1">
            Sessões: R$ <%= number_to_currency(@session_revenue || 0, unit: "", precision: 2) %> |
            Produtos: R$ <%= number_to_currency(@product_revenue || 0, unit: "", precision: 2) %>
          </p>
        </div>
        <div class="bg-green-100 p-3 rounded-full">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Sessões Ativas</p>
          <p class="text-3xl font-bold text-purple-600 mt-2"><%= @active_sessions %></p>
        </div>
        <div class="bg-purple-100 p-3 rounded-full">
          <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Total de Renovações</p>
          <p class="text-3xl font-bold text-yellow-600 mt-2"><%= @total_renewals %></p>
        </div>
        <div class="bg-yellow-100 p-3 rounded-full">
          <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Média de Renovações</p>
          <p class="text-3xl font-bold text-indigo-600 mt-2"><%= @avg_renewals %></p>
        </div>
        <div class="bg-indigo-100 p-3 rounded-full">
          <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-bold mb-4">Faturamento por Tipo</h2>

    <div class="space-y-4">
      <% if @revenue_by_type["sala_jogos"].to_f > 0 %>
        <div class="flex items-center justify-between p-4 bg-blue-50 rounded-lg">
          <div class="flex items-center">
            <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">Sala de Jogos</span>
          </div>
          <div class="text-2xl font-bold text-blue-600">
            R$ <%= number_to_currency(@revenue_by_type["sala_jogos"] || 0, unit: "", precision: 2) %>
          </div>
        </div>
      <% end %>

      <% if @revenue_by_type["playstation4"].to_f > 0 %>
        <div class="flex items-center justify-between p-4 bg-purple-50 rounded-lg">
          <div class="flex items-center">
            <span class="px-3 py-1 bg-purple-100 text-purple-800 text-sm font-semibold rounded-full">Playstation 4</span>
          </div>
          <div class="text-2xl font-bold text-purple-600">
            R$ <%= number_to_currency(@revenue_by_type["playstation4"] || 0, unit: "", precision: 2) %>
          </div>
        </div>
      <% end %>

      <% if @revenue_by_type["sinuca"].to_f > 0 %>
        <div class="flex items-center justify-between p-4 bg-green-50 rounded-lg">
          <div class="flex items-center">
            <span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-semibold rounded-full">Sinuca</span>
          </div>
          <div class="text-2xl font-bold text-green-600">
            R$ <%= number_to_currency(@revenue_by_type["sinuca"] || 0, unit: "", precision: 2) %>
          </div>
        </div>
      <% end %>

      <% if @revenue_by_type["sala_jogos"].to_f == 0 && @revenue_by_type["playstation4"].to_f == 0 && @revenue_by_type["sinuca"].to_f == 0 %>
        <p class="text-gray-500 text-center py-4">Nenhum faturamento no período selecionado.</p>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mt-6">
    <h2 class="text-xl font-bold mb-4">Vendas de Produtos</h2>

    <% if @product_sales_by_product.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Produto</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantidade Vendida</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Faturamento</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @product_sales_by_product.each do |row| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= row.product_name %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= row.total_quantity.to_i %> un.</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-medium">
                  R$ <%= number_to_currency(row.total_amount, unit: "", precision: 2) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4">Nenhuma venda de produto no período selecionado.</p>
    <% end %>
  </div>
</div>
